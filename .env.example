# =============================================================================
# Mise-Kal environment template
# =============================================================================
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed; this template is committed on purpose so that anyone
# can see which settings exist without seeing any of their values.
#
#   cp .env.example .env
#
# HOW TO TELL YOU HAVE DONE THIS RIGHT
#   `git status` should never list `.env`.
#   `.harness/scripts/security-check.sh` fails the build if it does.

# -----------------------------------------------------------------------------
# Nothing here is required to run Mise-Kal.
# -----------------------------------------------------------------------------
# The core system — POS, KDS, manager shell, reports, printing — runs with zero
# configuration. The restaurant's data lives on the restaurant's machine and no
# external service is contacted.
#
# Everything below is for optional integrations. Leaving all of it blank is a
# supported configuration: the features that need a value are simply
# unavailable, and the app says so rather than failing strangely.

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

# Port PocketBase listens on during local development.
# Default: 8090. Change it only if something else already uses that port.
PB_PORT=

# Where the development database lives, relative to server/.
# Default: ./pb_data. Point it at a scratch path if you want to be able to
# delete your test data without touching your real one.
PB_DATA_DIR=

# -----------------------------------------------------------------------------
# Payment provider (Phase 3 — QRIS)
# -----------------------------------------------------------------------------
# Not used yet. These names are reserved so that the integration layer has a
# documented contract to read from rather than inventing its own.
#
# NEVER commit a real value here. A leaked merchant key can move money.

QRIS_PROVIDER=
QRIS_MERCHANT_ID=
QRIS_API_KEY=
QRIS_CALLBACK_SECRET=

# Where the provider should send payment callbacks. Must be reachable from the
# provider's servers, which means a tunnel or a public host. The restaurant's
# own machine is not reachable from the internet by design.
QRIS_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Business notifications (Phase 4 — WhatsApp)
# -----------------------------------------------------------------------------
# Not used yet.

WA_NOTIFY_PROVIDER=
WA_NOTIFY_TOKEN=
WA_NOTIFY_SENDER=

# -----------------------------------------------------------------------------
# Packaging and signing
# -----------------------------------------------------------------------------
# Upstream ships unsigned on purpose and documents the warning users see.
# Set these only if you are paying for signing.

# macOS: the codesign identity, e.g. "Developer ID Application: Your Name (TEAMID)"
CODESIGN_IDENTITY=

# Windows: path to a code-signing certificate. Not used yet.
WINDOWS_CERT_PATH=
WINDOWS_CERT_PASSWORD=
